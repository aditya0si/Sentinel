# Sentinel — Environment Configuration
# At least one LLM provider is required for the demo agent.
# Sentinel auto-detects the first available provider in this order:
#   Groq (free) → Gemini (free) → OpenAI → Ollama (local, free)

# --- LLM Providers (pick one) ---

# Groq (free tier — fast, generous limits)
# Get key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (free tier — 15 RPM, 1M tokens/day)
# Get key at: https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIza...
# GOOGLE_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.0-flash

# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Ollama (local, free — install from https://ollama.ai)
# No key needed, just run: ollama serve && ollama pull llama3.2
# OLLAMA_MODEL=llama3.2

# --- Optional Services ---

# HuggingFace API Token (for toxicity classifier)
# HF_TOKEN=hf_...

# OTLP Endpoint (for observability export)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Agent config (optional override)
# AGENT_MODEL=auto
